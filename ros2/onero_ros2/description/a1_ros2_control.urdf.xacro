<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="onero_a1">

  <!-- Arguments -->
  <xacro:arg name="can_channel" default="can0"/>
  <xacro:arg name="model" default="A1"/>
  <xacro:arg name="kp" default="50.0"/>
  <xacro:arg name="kd" default="1.0"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>

  <!-- Mesh path macro -->
  <xacro:property name="mesh_prefix" value="package://onero_ros2/description/meshes/a1_r"/>

  <!-- ─── Links ─────────────────────────────────────────────────────── -->

  <link name="base_link">
    <inertial>
      <origin xyz="-2.12826196715557e-05 -5.52026218782097e-05 0.0171427754448579" rpy="0 0 0"/>
      <mass value="0.401650168942009"/>
      <inertia ixx="0.000237179758518644" ixy="1.22424408206913E-07" ixz="1.57836402935181E-07" iyy="0.000248236117612461" iyz="7.93541349379853E-07" izz="0.000305122605170233"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/base_link.STL"/></geometry>
      <material name="gray"><color rgba="0.776 0.757 0.737 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/base_link.STL"/></geometry>
    </collision>
  </link>

  <link name="Link1">
    <inertial>
      <origin xyz="0.000104793909039569 0.000878025489583305 0.0937688680157419" rpy="0 0 0"/>
      <mass value="0.438675872181416"/>
      <inertia ixx="0.00060517294321352" ixy="3.1414337686272E-07" ixz="9.46425739217291E-07" iyy="0.000501491467720591" iyz="-3.30016145254686E-05" izz="0.00025580993277449"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/Link1.STL"/></geometry>
      <material name="white"><color rgba="0.898 0.918 0.929 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/Link1.STL"/></geometry>
    </collision>
  </link>

  <link name="Link2">
    <inertial>
      <origin xyz="-4.66303482215547e-05 -0.0610765811025605 0.00481122218899704" rpy="0 0 0"/>
      <mass value="0.387770755219132"/>
      <inertia ixx="0.000597204372907025" ixy="8.36763420077846E-07" ixz="-2.69873967501812E-08" iyy="0.000348292487571024" iyz="-2.93717934653094E-05" izz="0.000403661570691348"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/Link2.STL"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/Link2.STL"/></geometry>
    </collision>
  </link>

  <link name="Link3">
    <inertial>
      <origin xyz="-1.43987309591522e-05 0.00178404133280441 0.109669668659996" rpy="0 0 0"/>
      <mass value="0.407125793506889"/>
      <inertia ixx="0.000446520666780017" ixy="-8.24275545731468E-09" ixz="1.61110520939152E-07" iyy="0.000343044757246363" iyz="-1.30123176926368E-05" izz="0.000286204871222088"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/Link3.STL"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/Link3.STL"/></geometry>
    </collision>
  </link>

  <link name="Link4">
    <inertial>
      <origin xyz="9.99808131922311e-07 0.0625047132640995 0.00555704355349793" rpy="0 0 0"/>
      <mass value="0.252142897202372"/>
      <inertia ixx="0.000178779070280237" ixy="-6.97346977234495E-09" ixz="-7.78451594087313E-10" iyy="0.000146134678616042" iyz="3.30147349592292E-05" izz="0.000165597697680657"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/Link4.STL"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/Link4.STL"/></geometry>
    </collision>
  </link>

  <link name="Link5">
    <inertial>
      <origin xyz="-2.1819607269304e-06 0.000940045309240356 0.0983077176130554" rpy="0 0 0"/>
      <mass value="0.333953527048094"/>
      <inertia ixx="0.000324219442352689" ixy="-1.17918294445498E-09" ixz="-7.21118252231978E-08" iyy="0.000299078218859742" iyz="5.7924183985276E-06" izz="0.000161241194938864"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/Link5.STL"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/Link5.STL"/></geometry>
    </collision>
  </link>

  <link name="Link6">
    <inertial>
      <origin xyz="1.41083567195476e-05 -0.0616500007920044 0.00592126579182656" rpy="0 0 0"/>
      <mass value="0.289938784061927"/>
      <inertia ixx="0.000346578289881221" ixy="-3.69413578027761E-07" ixz="1.71707534440891E-07" iyy="0.000183154957217547" iyz="-3.25615026642568E-05" izz="0.000268358636952706"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/Link6.STL"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/Link6.STL"/></geometry>
    </collision>
  </link>

  <link name="Link7">
    <inertial>
      <origin xyz="1.47613369245068e-07 -0.00220208936053254 0.00293052049190767" rpy="0 0 0"/>
      <mass value="0.017750642712371"/>
      <inertia ixx="2.81905932676299E-06" ixy="-6.21960184961116E-11" ixz="1.30043055619343E-13" iyy="1.89453432604882E-06" iyz="2.22904228240977E-09" izz="4.60994189557911E-06"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_prefix}/Link7.STL"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_prefix}/Link7.STL"/></geometry>
    </collision>
  </link>

  <!-- ─── Joints (exact transforms from CAD) ────────────────────────── -->

  <joint name="joint1-a1_r" type="revolute">
    <origin xyz="0.0 0.0 0.0125" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.04" upper="3.14" velocity="30.0" effort="15.0"/>
  </joint>

  <joint name="joint2-a1_r" type="revolute">
    <origin xyz="0.0 0.0 0.12745" rpy="1.5708 1.5708 0.0"/>
    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="0.26" velocity="30.0" effort="15.0"/>
  </joint>

  <joint name="joint3-a1_r" type="revolute">
    <origin xyz="0.0 -0.09325 -0.0001" rpy="1.5708 1.5708 0.0"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.76" upper="2.76" velocity="30.0" effort="15.0"/>
  </joint>

  <joint name="joint4-a1_r" type="revolute">
    <origin xyz="0.0 -0.001 0.14025" rpy="1.57079632678358 0.0 -6.73358220455809e-05"/>
    <parent link="Link3"/>
    <child link="Link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.92" upper="1.92" velocity="30.0" effort="3.0"/>
  </joint>

  <joint name="joint5-a1_r" type="revolute">
    <origin xyz="0.0 0.088 -0.001" rpy="-1.57079632679444 0.0 0.0"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.23" upper="2.23" velocity="30.0" effort="3.0"/>
  </joint>

  <joint name="joint6-a1_r" type="revolute">
    <origin xyz="0.0 0.0005 0.133" rpy="-1.5708 0.0 0.0"/>
    <parent link="Link5"/>
    <child link="Link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" velocity="30.0" effort="3.0"/>
  </joint>

  <joint name="joint7-a1_r" type="revolute">
    <origin xyz="0.0 -0.112 0.00025" rpy="1.5708 0.0 0.0"/>
    <parent link="Link6"/>
    <child link="Link7"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.76" upper="2.76" velocity="30.0" effort="3.0"/>
  </joint>

  <!-- ─── ros2_control ──────────────────────────────────────────────── -->

  <ros2_control name="onero_a1" type="system">
    <hardware>
      <xacro:if value="$(arg use_fake_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
        <param name="fake_sensor_commands">$(arg fake_sensor_commands)</param>
      </xacro:if>
      <xacro:unless value="$(arg use_fake_hardware)">
        <plugin>onero_ros2/OneroHardwareInterface</plugin>
        <param name="can_channel">$(arg can_channel)</param>
        <param name="model">$(arg model)</param>
        <param name="kp">$(arg kp)</param>
        <param name="kd">$(arg kd)</param>
      </xacro:unless>
    </hardware>

    <joint name="joint1-a1_r">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2-a1_r">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3-a1_r">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint4-a1_r">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint5-a1_r">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint6-a1_r">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint7-a1_r">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
