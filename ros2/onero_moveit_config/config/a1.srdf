<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic Robot Description for Onero A1 (7-DOF arm).
  Defines planning groups, named poses, and self-collision matrix.
-->
<robot name="onero_a1">

  <!-- Planning group: full arm chain -->
  <group name="arm">
    <chain base_link="base_link" tip_link="Link7"/>
  </group>

  <!-- Named poses -->
  <group_state name="home" group="arm">
    <joint name="joint1-a1_r" value="0.0"/>
    <joint name="joint2-a1_r" value="0.0"/>
    <joint name="joint3-a1_r" value="0.0"/>
    <joint name="joint4-a1_r" value="0.0"/>
    <joint name="joint5-a1_r" value="0.0"/>
    <joint name="joint6-a1_r" value="0.0"/>
    <joint name="joint7-a1_r" value="0.0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="joint1-a1_r" value="0.0"/>
    <joint name="joint2-a1_r" value="-1.0"/>
    <joint name="joint3-a1_r" value="0.0"/>
    <joint name="joint4-a1_r" value="-1.5"/>
    <joint name="joint5-a1_r" value="0.0"/>
    <joint name="joint6-a1_r" value="0.5"/>
    <joint name="joint7-a1_r" value="0.0"/>
  </group_state>

  <!-- Virtual joint: fixed to world -->
  <virtual_joint name="world_joint" type="fixed"
                 parent_frame="world" child_link="base_link"/>

  <!-- Self-collision exclusions (adjacent links) -->
  <disable_collisions link1="base_link" link2="Link1" reason="Adjacent"/>
  <disable_collisions link1="Link1" link2="Link2" reason="Adjacent"/>
  <disable_collisions link1="Link2" link2="Link3" reason="Adjacent"/>
  <disable_collisions link1="Link3" link2="Link4" reason="Adjacent"/>
  <disable_collisions link1="Link4" link2="Link5" reason="Adjacent"/>
  <disable_collisions link1="Link5" link2="Link6" reason="Adjacent"/>
  <disable_collisions link1="Link6" link2="Link7" reason="Adjacent"/>
  <!-- Near-adjacent (never collide due to geometry) -->
  <disable_collisions link1="base_link" link2="Link2" reason="Never"/>
  <disable_collisions link1="Link1" link2="Link3" reason="Never"/>
  <disable_collisions link1="Link5" link2="Link7" reason="Never"/>

</robot>
